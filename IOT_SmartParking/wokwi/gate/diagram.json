      "attrs": {}
    },
    {
      "type": "wokwi-hc-sr04",
      "id": "sensor_gate_in",
      "top": -220,
      "left": 300,
      "attrs": { "distance": "200" }
    },
    {
      "type": "wokwi-servo",
      "id": "barrier_in",
      "top": -60,
      "left": 300,
      "attrs": {}
    },
    {
      "type": "wokwi-servo",
      "id": "barrier_out",
      "top": 80,
      "left": 300,
      "attrs": {}
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_gate_out",
      "top": 200,
      "left": 250,
      "attrs": { "color": "orange" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_cp1",
      "top": 200,
      "left": 350,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-pushbutton",
      "id": "btn_cp2",
      "top": 200,
      "left": 450,
      "attrs": { "color": "blue" }
    },
    {
      "type": "wokwi-lcd2004",
      "id": "statusDisplay",
