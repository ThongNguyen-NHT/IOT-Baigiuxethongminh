  "connections": [
    [ "esp:23", "sensor_gate_in:TRIG", "green", [] ],
    [ "esp:34", "sensor_gate_in:ECHO", "blue", [] ],
    [ "esp:VIN", "sensor_gate_in:VCC", "red", [] ],
    [ "esp:GND.1", "sensor_gate_in:GND", "black", [] ],

    [ "esp:4", "barrier_in:PWM", "orange", [] ],
    [ "esp:VIN", "barrier_in:V+", "red", [] ],
    [ "esp:GND.1", "barrier_in:GND", "black", [] ],

    [ "esp:16", "barrier_out:PWM", "orange", [] ],
    [ "esp:VIN", "barrier_out:V+", "red", [] ],
    [ "esp:GND.1", "barrier_out:GND", "black", [] ],

    [ "esp:18", "btn_gate_out:1.l", "orange", [] ],
    [ "esp:GND.1", "btn_gate_out:2.l", "black", [] ],

    [ "esp:19", "btn_cp1:1.l", "blue", [] ],
    [ "esp:GND.1", "btn_cp1:2.l", "black", [] ],

    [ "esp:32", "btn_cp2:1.l", "blue", [] ],
    [ "esp:GND.1", "btn_cp2:2.l", "black", [] ],

    [ "esp:21", "statusDisplay:SDA", "green", [] ],
    [ "esp:22", "statusDisplay:SCL", "yellow", [] ],
    [ "esp:VIN", "statusDisplay:VCC", "red", [] ],
    [ "esp:GND.1", "statusDisplay:GND", "black", [] ]
